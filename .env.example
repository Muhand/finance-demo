# Names here must match what the code actually reads. Verified against
# `grep -rhoE 'env\.[A-Z_]+' apps/api/src apps/web/src`.

# ---- LLM (question generation + sub-agents + synthesis) ----
# Unset -> deterministic offline StubLlm (template text, NOT model output).
ANTHROPIC_API_KEY=
# Optional; these are the defaults.
ANTHROPIC_SYNTHESIS_MODEL=claude-sonnet-5
ANTHROPIC_SUBAGENT_MODEL=claude-haiku-4-5

# ---- Vector database ----
# Unset -> in-process MemoryVectorStore (lost on restart).
PINECONE_API_KEY=
PINECONE_INDEX=finance-demo
# The Pinecone index must already exist, with dimension=384 metric=cosine.
# Setting PINECONE_INDEX does not create it.

# ---- Embeddings ----
# "local" -> Xenova/all-MiniLM-L6-v2 (384d, needs @huggingface/transformers).
# Anything else -> HashEmbedder: deterministic, 384d, but NOT semantic.
EMBEDDER=
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Where model weights are cached. Must be writable — on Vercel use /tmp/hf.
EMBEDDING_CACHE_DIR=

# ---- SEC EDGAR (required by SEC fair-access policy) ----
SEC_USER_AGENT=FinanceDemo/1.0 (you@example.com)

# ---- Runtime ----
# Standalone Hono server only; ignored when the API runs as a Next route.
PORT=4000
# Extra comma-separated CORS origins; localhost:3000 is always allowed.
WEB_ORIGIN=
# Where completed research is persisted, which is what makes the
# "no new filings -> reuse" path work. Must be writable: on Vercel use
# /tmp/research, since everything outside /tmp is read-only.
RESEARCH_CACHE_DIR=
# Override the bundled SEC ticker directory.
TICKERS_PATH=
