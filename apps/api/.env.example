# apps/api configuration. Every value here is optional: with none of them set
# the API boots and answers requests using deterministic offline fakes.

PORT=4000
# Extra comma-separated CORS origins. localhost:3000 is always allowed.
# WEB_ORIGIN=http://localhost:3001

# EDGAR requires a descriptive User-Agent on every request.
SEC_USER_AGENT=FinanceDemo/1.0 (you@example.com)

# Unset -> StubLlm (deterministic, offline).
# ANTHROPIC_API_KEY=
# ANTHROPIC_SYNTHESIS_MODEL=claude-sonnet-5
# ANTHROPIC_SUBAGENT_MODEL=claude-haiku-4-5

# Unset -> MemoryVectorStore. The index must be dimension 384, metric cosine.
# PINECONE_API_KEY=
# PINECONE_INDEX=finance-demo

# "local" -> Xenova/all-MiniLM-L6-v2 (requires the optional
# @huggingface/transformers dependency). Anything else -> HashEmbedder.
# EMBEDDER=local
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Where completed research runs are persisted (gitignored).
# RESEARCH_CACHE_DIR=./.data/research
